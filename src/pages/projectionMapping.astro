---
import '../styles/global.css' 
import Header from '../components/header.astro'
---

<!-- bg-[url('billeder/rulle.png')] bg-cover bg-fixed -->

<body class="m-0">

    
    <Header/>
    

    <div class="grid grid-cols-4 grid-rows-31 p-5">
        

        <div class="row-start-4 col-start-1 col-span-4 row-span-4 place-self-center">
            <img src="/billeder/projectionmapping/PMproces.gif" class="w-220 saturate-200">
        </div>

        <div class="row-start-2 col-start-1 row-span-2 col-span-4 place-self-center">
            <p class="text-[80px] font-serif italic text-blue-600 text-center"> 
                a heart turned cold
            </p>
        </div>
        
        <div class="z-0 row-start-8 col-span-4 row-span-5">
            <p class="font-serif text-blue-600 text-[40px]">
                this is an interactive installation, interpreting the H.C. Andersen fairytale <span class="font-bold italic">"The Snow Queen".</span>
                <br> 
                <br> made possible with touchdesigner, the viewer sensed both a flourishing rose garden, & an ice cold forest, leading to the Queens Castle.
                <br> 
                <br> the project is an experiment with storytelling, remixing videos, and mapping them onto a surface.
            </p>
        </div>

