---
import '../styles/global.css' 
import Header from '../components/header.astro'
---



<body class="m-0 bg-[url('billeder/rulle.png')] bg-cover bg-fixed">

    
    <Header/>
    

    <div class="grid grid-cols-4 grid-rows-15 p-5">
        
        
        

        <div class="row-start-2 col-span-3 row-span-3 w-190 place-items-center pt-30">
            <img src="/billeder/projectionmapping/PMproces.gif" class="saturate-200">
        </div>
        
        <div class="row-start-5 col-span-3 row-span-2 p-4 pl-20">
            <p class="font-serif text-blue-600 text-[40px]">
                <span class="text-[65px] italic col-span-4 bg-cyan-300">a heart turned cold</span>
                <br> this is an interactive installation, interpreting the H.C. Andersen fairytale <span class="font-bold italic">"The Snow Queen"</span>
            </p>
        </div>


        <div class="row-start-12 row-span-2 col-span-3 pl-15">
            <p class="font-serif text-blue-600 text-[40px]">
                made possible with touchdesigner, the viewer sensed both a flourishing rose garden, & an ice cold forest, leading to the Queens Castle.
            </p>
        </div>

        <div class="row-start-9 col-span-3 row-span-3 w-150 place-self-center">
            <img src="/billeder/projectionmapping/mathias.jpeg" class="saturate-200">
        </div>

        <div class=" row-start-8 col-start-3 col-span-2 place-self-center w-70 ">
            <img src="/billeder/projectionmapping/PM1.gif" class="saturate-200">
        </div>

        
        
        <!-- GLITTER GRAPHICS -->
        
        <!-- snefnug -->
        <div class="row-start-7 col-span-3 place-self-center saturate-200">
            <img src="http://dl7.glitter-graphics.net/pub/1820/1820327bp68khrj6q.gif" width=448 height=115> 
        </div>
        
        <!-- rose -->
        <div class="row-start-12 col-start-4 row-span-2 ">
            <img src="http://dl.glitter-graphics.net/pub/420/420021lpjc7ug7l1.gif" width=135 height=191> 
        </div>
        
        



    </div>

</body>