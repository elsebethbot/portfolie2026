---
import '../styles/global.css' 
import Header from '../components/header.astro'
---



<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>EDUPSCH</title>


        <link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Ballet:opsz@16..72&display=swap" rel="stylesheet">
	</head>

<body class="m-0 pt-15">
    <Header/>

    
    
    <div class="grid grid-cols-4 p-5 md:grid-cols-12">

        <!-- specs -->
        <div class="hidden
        md:inline md:row-start-11 md:col-start-2 md:row-span-3 md:col-span-2 md:place-self-center">
            <img src="/billeder/aabenOel/specs_aaben.jpg" class="md:p-8 grayscale">
        </div>

        <div class="row-start-2 col-start-1 col-span-1 row-span-2 place-self-center
        md:row-start-1 md:col-start-1 md:row-span-2 md:col-span-3">
            <img src="/billeder/aabenOel/beer1.gif">
        </div>
        <div class="row-start-2 col-start-2 col-span-1 row-span-2 place-self-center
        md:row-start-1 md:col-start-4 md:row-span-2 md:col-span-3">
            <img src="/billeder/aabenOel/beer2.gif">
        </div>
        <div class="row-start-2 col-start-3 col-span-1 row-span-2 place-self-center
        md:row-start-1 md:col-start-7 md:row-span-2 md:col-span-3">
            <img src="/billeder/aabenOel/beer3.gif">
        </div>
        <div class="row-start-2 col-start-4 col-span-1 row-span-2 place-self-center
        md:row-start-1 md:col-start-10 md:row-span-2 md:col-span-3">
            <img src="/billeder/aabenOel/beer4.gif">
        </div>


        
        <div class="row-start-12 col-start-1 row-span-2 col-span-5 
        md:row-start-7 md:col-start-5 md:row-span-3 md:col-span-4">
            <p class="font-serif text-blue-600 text-[20px] pl-15
            md:text-[30px] md:pt-20">
                beer makes you dance silly.
                <br> beer is rock 'n' roll.
                <br> beer will make you giggle.
                <br> beer + friends = vibes.
            </p>
        </div>

       
        <div class="row-start-14 col-start-1 row-span-2 col-span-4
        md:row-start-10 md:col-start-5 md:row-span-3 md:col-span-4">
            <p class="font-serif text-blue-600 text-[20px] pt-5
            md:pt-30">
                for this project, I made a drawing tool, to generate unique labels for ÅBEN brewery beer cans.
                <br> 
                <br> got a lot of inspiration from their existing visual style, but more so their love & passion for creating fun events, such as parties or the  O Days festival.
            </p>
        </div>

        <div class="hidden
        md:inline md:row-start-20 md:col-start-2 md:row-span-1 md:col-span-10">
            <img src="/billeder/aabenOel/generatoren.png">
        </div>
        <div class="row-start-45 col-start-1 row-span-5 col-span-4 pt-5
        md:row-start-21 md:col-start-4 md:row-span-1 md:col-span-6 md:pt-50">
            <img src="/billeder/aabenOel/daaser.png" class="md:border-2 md:border-pink-500">
        </div>

        <div class="row-start-16 col-start-1 col-span-4 row-span-4 place-self-center saturate-100
        md:row-start-18 md:col-start-1 md:col-span-12 md:row-span-1 md:pb-50">
            <video autoplay muted loop controls >
                <source src="/billeder/aabenOel/aabenDemo.mp4" type="video/mp4">
            </video>
        </div>

        <div class="row-start-20 col-start-2 row-span-1 col-span-3
        md:row-start-13 md:col-start-5 md:row-span-1 md:col-span-4">
            <p class="font-serif text-blue-600 text-[20px]
            md:pt-20 md:pb-20">
                that's why the brush strokes are png's mainly of people dancing.
            </p>
        </div>

        <!-- dancerssss -->
        <div class="hidden
        md:inline md:row-start-15 md:col-start-4 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans2.png" class="w-40">
        </div>
        <div class="row-start-20 col-start-1 row-span-2 place-self-center
        md:row-start-15 md:col-start-5 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans3.png">
        </div>
        <div class="row-start-23 col-start-3 row-span-2 col-span-2 place-self-center
        md:row-start-15 md:col-start-6 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans5.png" class="w-30 p-3 md:p-0">
        </div>
        <div class="hidden
        md:inline md:row-start-14 md:col-start-4 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans1.png">
        </div>
        <div class="hidden
        md:inline md:row-start-14 md:col-start-5 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans4.png">
        </div>
        <div class="hidden
        md:inline md:row-start-14 md:col-start-6 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans7.png">
        </div>
        <div class="hidden
        md:inline md:row-start-14 md:col-start-7 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans8.png">
        </div>
        <div class="hidden
        md:inline md:row-start-14 md:col-start-8 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans12.png">
        </div>
        <div class="hidden
        md:inline md:row-start-14 md:col-start-9 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans14.png">
        </div>
        <div class="hidden
        md:inline md:row-start-15 md:col-start-7 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans15.png">
        </div>
        <div class="hidden
        md:inline md:row-start-15 md:col-start-8 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans16.png">
        </div>
        <div class="hidden
        md:inline md:row-start-15 md:col-start-9 md:row-span-1 md:col-span-1">
            <img src="/billeder/aabenOel/dansere/dans17.png">
        </div>




        <div class="row-start-22 col-start-1 row-span-2 col-span-4
        md:row-start-16 md:col-start-5 md:col-span-4 md:row-span-1">
            <p class="font-serif text-blue-600 text-[20px]
            md:pt-20 md:pb-20">
                individually, they're kinda silly, but when drawn with, they create abstract patterns.
            </p>
        </div>
        <div class="hidden
        md:inline md:row-start-17 md:col-start-5 md:col-span-6 md:row-span-1">
            <p class="md:font-serif md:text-blue-600 md:text-[42px]
            md:pb-50">
                in the name of beer; 
                <br> <span style="font-family: 'Ballet', cursive;" class="text-[100px]">Let the creative juices flow!</span>
            </p>
        </div>


        

        <div class="row-start-23 col-start-1 col-span-4 row-span-3
        md:row-start-22 md:col-start-2 md:col-span-10 md:row-span-1">
            <img class="pt-40" src="/billeder/aabenOel/BRYG_61.png">
        </div>
        <div class="row-start-26 col-start-1 col-span-4 row-span-3
        md:row-start-23 md:col-start-2 md:col-span-10 md:row-span-1 ">
            <img class="pt-5" src="/billeder/aabenOel/HERR_STAHLBAUM.png">
        </div>
        <div class="row-start-29 col-start-1 col-span-4 row-span-3
        md:row-start-24 md:col-start-2 md:col-span-10 md:row-span-1 ">
            <img class="pt-5" src="/billeder/aabenOel/Y.png">
        </div>
        <div class="row-start-32 col-start-1 col-span-4 row-span-3
        md:row-start-25 md:col-start-2 md:col-span-10 md:row-span-1 ">
            <img class="pt-5" src="/billeder/aabenOel/STOLEN.png">
        </div>
        <div class="row-start-35 col-start-1 col-span-4 row-span-3
        md:row-start-26 md:col-start-2 md:col-span-10 md:row-span-1 ">
            <img class="pt-5" src="/billeder/aabenOel/OCCULATION.png">
        </div>
        <div class="row-start-38 col-start-1 col-span-4 row-span-3
        md:row-start-27 md:col-start-2 md:col-span-10 md:row-span-1 ">
            <img class="pt-5" src="/billeder/aabenOel/SPECULAR.png">
        </div>
        <div class="row-start-41 col-start-1 col-span-4 row-span-3
        md:row-start-28 md:col-start-2 md:col-span-10 md:row-span-1 ">
            <img class="pt-5" src="/billeder/aabenOel/SUGARPLUM.png">
        </div>
        



    </div>



</body>

</html>