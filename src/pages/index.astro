---
  import '../styles/global.css' 
  import NameTag from '../components/nameTag.astro'
  
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>EDUPSCH</title>
	</head>


	<body class="m-0 bg-white">
		
		<div class="grid grid-cols-3 grid-rows-18 p-3
		md:grid-cols-10 md:grid-rows-11">

			<!-- <div class="col-start-10 row-start-6 row-span-5">
				<NameTag/>
			</div> -->


			
			
			<div class="row-start-4 row-span-3 col-start-1 col-span-3 w-40 place-self-center
			md:row-start-2 md:col-start-4 md:col-span-2 md:row-span-3">
				<img src="/billeder/landofels2.jpg">
			</div>

			<div class="hidden
			md:inline md:row-start-6 md:col-start-10 md:col-span-1 md:row-span-2">
				<img src="/billeder/death.png">
			</div>

			<div class="col-start-1 row-start-8 row-span-2 w-20 place-self-center
			md:row-start-1 md:col-start-10 md:row-span-1 md:w-15">
				<img src="/billeder/forsidefruen/hehe.jpg" class="saturate-200">
			</div>

			<div class="col-start-3 row-start-9 row-span-2 w-20 place-self-center
			md:row-start-1 md:col-start-7">
				<img src="/billeder/forsidefruen/hacker.jpeg" class="saturate-200">
			</div>

			<div class="col-start-3 row-start-3 row-span-2 place-self-center
			md:row-start-2 md:col-start-8">
				<img src="/billeder/forsidefruen/negle.jpg" class=" w-15 saturate-200
				md:hover:invert">
			</div>

			<div class="col-start-1 row-start-1 row-span-3 w-20 place-self-center
			md:row-start-2 md:col-start-10 md:place-self-end">
				<img src="/billeder/forsidefruen/spejl.jpg" class="saturate-200">
			</div>

			<div class="col-start-2 col-span-2 row-start-8 w-20 place-self-center
			md:row-start-4 md:col-start-9">
				<img src="/billeder/forsidefruen/monner.jpg" class="saturate-200">
			</div>

			<div class="col-start-2 row-start-11 row-span-2 w-30 place-self-center
			md:row-start-4 md:col-start-7 md:col-span-2">
				<img src="/billeder/forsidefruen/miggif.gif" class="saturate-200">
			</div>

			<!-- GLITTER GRAPHICS -->

			<!-- lys -->
			<div class="hidden
			md:inline md:row-start-4 md:col-start-1 md:row-span-4 md:col-span-2">
				<img src="http://dl7.glitter-graphics.net/pub/1742/1742527pod8ixyt2l.gif" width=182 height=216>
			</div>

			<!-- computer -->
			<div class="row-start-14 col-start-1 row-span-2 col-span-2 w-20 place-self-center
			md:row-start-5 md:col-start-8">
				<img src="http://dl.glitter-graphics.net/pub/511/511791t0gnjo0n7k.gif" width=150 height=150>
			</div>

			<!-- tribal divider -->
			<div class="row-start-7 col-start-2 w-30 place-self-center
			md:row-start-5 md:col-start-4 md:col-span-2">
				<img src="http://dl.glitter-graphics.net/pub/621/621641xy2arhaa2t.gif" width=300 height=111>
			</div>

			<!-- dollartegn -->
			<div class="row-start-2 col-start-2 col-span-2 place-self-center
			md:row-start-3 md:col-start-7">
				<img class="w-8" src="http://dl9.glitter-graphics.net/pub/766/766999jvyb8rl84u.gif" width=52 height=86>
			</div>

			<!-- peace tegn -->
			<div class="row-start-4 col-start-1 place-self-center
			md:row-start-1 md:col-start-9 md:row-span-2">
				<img class="w-10 md:w-30" src="http://dl6.glitter-graphics.net/pub/1892/1892496uma4rbp6ml.gif">
			</div>

			<!-- øjne + scroll or read -->
			<div class="hidden
			md:inline md:row-start-10 md:col-start-7 md:row-span-1 md:col-span-1">
				<img src="http://dl.glitter-graphics.net/pub/127/127461l6gyj8vwix.gif" width=600 height=140>
			</div>
			<div class="hidden
			md:inline md:row-start-9 md:col-start-7 md:row-span-1 md:col-span-1 md:place-self-center">
				<p class="md:text-[20px] md:text-blue-600 md:font-serif md:pt-7">
					scroll
				</p>
			</div>
			<div class="hidden
			md:inline md:row-start-10 md:col-start-8 md:row-span-1 md:col-span-1 md:text-center">
				<p class="md:text-[20px] md:text-blue-600 md:font-serif">
					or
				</p>
			</div>
		
			<div class="row-start-13 col-start-3 row-span-1 col-span-1
			md:inline md:row-start-10 md:col-start-9 md:row-span-1 md:col-span-1">
				<a href="/about">
					<img class="invert" src="http://dl.glitter-graphics.net/pub/127/127461l6gyj8vwix.gif" width=600 height=140>
				</a>
			</div>
			<div class="row-start-12 col-start-3 row-span-1 col-span-1 place-self-center
			md:inline md:row-start-9 md:col-start-9 md:row-span-1 md:col-span-1 md:place-self-center">
				<a href="/about">
					<p class="text-[20px] text-blue-600 font-serif pt-7 underline 
					md:hover:underline md:no-underline ">
						read
					</p>
				</a>
			</div>
			


			<div class="col-start-1 col-span-4 row-start-15 row-span-5 place-self-center
			md:row-start-6 md:col-start-1">
				<p class="font-serif italic text-[30px] text-blue-600 p-1" lang="en">
					i design with great <span class="bg-pink-500 text-cyan-300">passion.</span>
					i feel an <span class="bg-lime-300 text-pink-500">obligation</span> to be bold
					& a need to <span class="bg-purple-500 text-amber-200">push boundaries.</span>
					i never wanna miss a dream ... 🧩
				</p>
			</div>
			
			<p class="col-start-1 row-start-13 row-span-2 text-[30px] text-center align-text-bottom
			md:row-start-1 md:col-start-1 md:row-span-1 md:text-start">
				🫟
			</p>
			<p class="col-start-3 row-start-14 row-span-2 text-[50px] text-center align-text-top
			md:row-start-6 md:col-start-2 md:col-span-2">
				🫀
			</p>
			<p class="col-start-1 row-start-20 text-[30px] text-right align-text-bottom
			md:row-start-9 md:col-start-4">
				💋
			</p>
			<div class="col-start-3 row-start-20 w-12
			md:row-start-9 md:col-start-5">
				<img src="/billeder/manden.jpg" class="md:hover:invert">
			</div>

		</div>


		<!-- DEL TO -->

		<div id="myprojects" class="grid grid-cols-3 grid-rows-20 p-3 pt-15
		md:grid-cols-11 md:grid-rows-10">
			
			<div class="col-start-2 row-start-1 row-span-2 pb-10 w-100 place-self-center
			md:row-start-1 md:col-start-5 md:col-span-3 md:row-span-2">
				<img src="/billeder/myprojects.jpg">
			</div>
			<div class="w-20 row-start-1 col-start-1 row-span-3
			md:row-start-1 md:col-start-5 md:col-span-3 md:row-span-2">
				<img src="/billeder/msp.png" class=" saturate-200 hue-rotate-185">
			</div>

			<!-- city branding -->
			<div class="col-start-1 row-start-3 row-span-2 col-span-3 w-60 place-self-center
			md:col-start-1 md:row-start-3 md:row-span-2 md:col-span-3 md:w-50 md:place-self-center">
				<a href="/glasgow">
					<img src="/billeder/citybranding/glasgowslides.gif">
				</a>
			</div>
			<div class="-z-50 col-start-1 row-start-3 row-span-2 col-span-3 w-80 place-self-center">
				<img src="/billeder/banner.jpg">
			</div>



			<!-- projection mapping -->
			<div class="col-start-1 row-start-7 row-span-2 col-span-3 w-60 place-self-center
			md:col-start-2 md:row-start-5 md:row-span-2 md:col-span-3 md:w-50 md:place-self-center">
				<a href="/projectionMapping">
					<img src="/billeder/projectionmapping/PM1.gif">
				</a>
			</div>
			<div class="-z-50 col-start-1 row-start-7 row-span-2 col-span-3 w-80 place-self-center
			md:-z-50 md:col-start-2 md:row-start-5 md:row-span-2 md:col-span-3 md:place-self-center">
				<img src="/billeder/banner.jpg">
			</div>


			<!-- musikvideo -->
			<div class="col-start-1 row-start-5 row-span-2 col-span-3 w-60 place-self-center
			md:col-start-5 md:row-start-4 md:row-span-2 md:col-span-3 md:w-50 md:place-self-center">
				<a href="/musikvideo">
					<img src="/billeder/musikvideo/musikvideo.gif">
				</a>
			</div>
			<div class="-z-50 col-start-1 row-start-5 row-span-2 col-span-3 w-80 place-self-center
			md:-z-50 md:col-start-5 md:row-start-4 md:row-span-2 md:col-span-3 md:place-self-center">
				<img src="/billeder/banner.jpg">
			</div>

			

			<!-- cphdox -->
			<div class="col-start-1 row-start-9 row-span-2 col-span-3 w-60 place-self-center
			md:col-start-9 md:row-start-3 md:row-span-2 md:col-span-3 md:w-50 md:place-self-center">
				<a href="/cphdox">
					<img src="/billeder/cphdox/skelet.gif">
				</a>
			</div>
			<div class="-z-50 col-start-1 row-start-9 row-span-2 col-span-3 w-80 place-self-center
			md:-z-50 md:col-start-9 md:row-start-3 md:row-span-2 md:col-span-3 md:place-self-center">
				<img src="/billeder/banner.jpg">
			</div>
			

			<!-- åben øl -->
			<div class="col-start-1 row-start-11 row-span-2 col-span-3 w-60 place-self-center
			md:col-start-8 md:row-start-5 md:row-span-2 md:col-span-3 md:w-50 md:place-self-center">
				<a href="/aaben">
					<img src="/billeder/aabenOel/aaben.gif">
				</a>
			</div>
			<div class="-z-50 col-start-1 row-start-11 row-span-2 col-span-3 w-80 place-self-center
			md:-z-50 md:col-start-8 md:row-start-5 md:row-span-2 md:col-span-3 md:place-self-center">
				<img src="/billeder/banner.jpg">
			</div>

			<!-- kalender -->
			<div class="col-start-1 row-start-13 row-span-2 col-span-3  place-self-center
			md:col-start-5 md:row-start-6 md:row-span-2 md:col-span-3 md:w-50 md:place-self-center">
				<a href="/kalender">
					<img src="/billeder/kalender/kalenderdemo.gif" class="w-50">
				</a>
			</div>
			<div class="-z-50 col-start-1 row-start-13 row-span-2 col-span-3 w-80 place-self-center
			md:-z-50 md:col-start-5 md:row-start-6 md:row-span-2 md:col-span-3 md:place-self-center">
				<img src="/billeder/banner.jpg">
			</div>




			<!-- solbriller -->
			<div class="row-start-16 col-start-2 row-span-1 col-span-1
			md:row-start-9 md:col-start-4 md:col-span-2 md:place-self-center">
				<img class="md:w-40" src="http://dl3.glitter-graphics.net/pub/1440/1440293o2z1p5lcqb.gif" width=250 height=120>
			</div>

			<!-- lipgloss -->
			<div class="hidden
			md:inline md:row-start-10 md:col-start-6 md:row-span-1 md:col-span-1">
				<img class="md:w-40" src="http://dl10.glitter-graphics.net/pub/539/539420j2he5wo9pw.jpg" width=162 height=162>
			</div>

			<!-- telefon -->
			<div class="hidden
			md:inline md:row-start-9 md:col-start-3 md:row-span-1 md:col-span-1">
				<img class="md:w-40" src="http://dl3.glitter-graphics.net/pub/1842/1842763oy9hhb431b.gif" width=500 height=438>
			</div>


		</div>
		
		
		
	</body>



	</html>
